# Copy to .env for local use: cp .env.example .env
# These are LOCAL DEMO credentials only; never reuse them elsewhere.

# PostgreSQL superuser (container bootstrap only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-local

# Separate migration/owner role and application role.
# The application role cannot UPDATE/DELETE audit history.
CCP_DB=ccp
CCP_OWNER_USER=ccp_owner
CCP_OWNER_PASSWORD=change-me-owner-local
CCP_APP_USER=ccp_app
CCP_APP_PASSWORD=change-me-app-local

# APP_ENV: local | test | production (production refuses demo identities)
APP_ENV=local
# AUTH_MODE: local-demo | oidc (oidc is not implemented, so startup fails)
AUTH_MODE=local-demo
SECRET_KEY=change-me-to-a-long-random-local-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Testable clock: empty for system time, or e.g. 2026-10-08T12:00:00Z
APP_CLOCK_FIXED=

# Delivery seams. Only these values are implemented; anything else fails startup.
HANDOFF_ADAPTER=local-export
PIPELINE_MODE=mock
ENABLE_LIVE_DEPLOYMENT=false

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Only behind a TLS-intercepting proxy: PEM bundle passed to image builds as a build secret.
EXTRA_CA_CERT=
